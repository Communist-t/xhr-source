# ============================================================
# x.HR 全量源码备份仓 .gitignore
# 定位：备份全部源码（启动器 WPF + apps/WeChatRPA 的 py/html/脚本/资源）。
# 内嵌 Python 环境、appr 产物、构建输出由同步脚本在拷贝阶段排除；
# 本文件兜底防运行态、隐私与密钥误入库。
# ============================================================

# ---- 构建产物 / 大体积制品 ----
bin/
obj/
publish/
dist/
build/
*.zip
*.7z
*.rar
.screenshots/
appr/

# ---- WeChatRPA 运行态 / 个人隐私 / 密钥（本机生成，不入库）----
apps/WeChatRPA/runtime/python/
apps/WeChatRPA/runtime/skills/
apps/WeChatRPA/runtime/logs/
apps/WeChatRPA/runtime/screenshots/
apps/WeChatRPA/runtime/conversation_memory/
apps/WeChatRPA/runtime/events/
apps/WeChatRPA/runtime/__pycache__/
apps/WeChatRPA/runtime/_crops/
apps/WeChatRPA/runtime/_probe_tmp/
apps/WeChatRPA/runtime/*.pid
apps/WeChatRPA/runtime/my_contacts.json
apps/WeChatRPA/runtime/chat_strategy_config.json
apps/WeChatRPA/runtime/moments_queue.json
apps/WeChatRPA/runtime/downloaded_skills.json
apps/WeChatRPA/runtime/moments_config.json
apps/WeChatRPA/runtime/change_detect_config.json
apps/WeChatRPA/runtime/relay_config.json
apps/WeChatRPA/runtime/user_config.local.json
apps/WeChatRPA/**/*.bak*
apps/WeChatRPA/**/__pycache__/

# ---- 本地密钥 / 通用 ----
*.local.json
secrets.*
.env
.env.*

# ---- IDE / 系统 ----
.vs/
.idea/
*.user
*.suo
.DS_Store
Thumbs.db
desktop.ini
