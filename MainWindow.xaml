<Window x:Class="Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Launcher.Converters"
        xmlns:vm="clr-namespace:Launcher.ViewModels"
        xmlns:ctl="clr-namespace:Launcher.Controls"
        Title="xHR" Height="1001" Width="1209"
        Icon="app.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>

        <!-- 导航项：程序页激活态 -->
        <Style x:Key="NavPrograms" BasedOn="{StaticResource NavItem}" TargetType="Button">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProgramsActive}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SoftBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 导航项：设置页激活态 -->
        <Style x:Key="NavSettings" BasedOn="{StaticResource NavItem}" TargetType="Button">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSettingsActive}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SoftBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 导航项：技能广场激活态 -->
        <Style x:Key="NavMarketplace" BasedOn="{StaticResource NavItem}" TargetType="Button">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMarketplaceActive}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SoftBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <local:AspectRatioConverter x:Key="AspectRatio"/>
        <local:InverseBoolConverter x:Key="InverseBool"/>
        <local:StringToVisibilityConverter x:Key="StringToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧边栏 ===== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,24,20,20">

                <!-- 底部：设置 + 用户卡片 + 版本号 -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="NavSettingsBtn" Style="{StaticResource NavSettings}" Margin="0,0,0,10"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Settings}"
                            Content="设置"/>
                    <Border x:Name="UserCard" Background="{StaticResource SoftBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource PrimaryBrush}" Margin="0,0,12,0">
                                <TextBlock Text="{Binding CurrentUsername, Converter={x:Static local:FirstLetterConverter.Instance}}"
                                           Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUsername}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
                                <TextBlock Text="{Binding CurrentRole}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Version}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="4,0,0,0"/>
                </StackPanel>

                <!-- 品牌 Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,28">
                    <Image Source="assets/logo.png" Width="32" Height="32" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="xHR" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
                        <TextBlock Text="数字员工工作台" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 顶部导航：本地启动器 / 技能广场 -->
                <StackPanel x:Name="NavSection" DockPanel.Dock="Top" Margin="0,0,0,16">
                    <Button Style="{StaticResource NavPrograms}" Margin="0,0,0,6"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Programs}"
                            Content="员工"/>
                    <Button Style="{StaticResource NavMarketplace}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Marketplace}"
                            Content="技能广场"/>
                </StackPanel>

                <!-- 我创建的云端员工（来自 /api/skills/user，与本地启动器分离），按分类分组 -->
                <ScrollViewer x:Name="SkillScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="我创建的" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="4,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding SkillGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <!-- 分类小标题 + 数量 + 归属标注（这个组在哪用） -->
                                        <StackPanel Orientation="Horizontal" Margin="4,0,0,8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource FgBrush}"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0"
                                                       VerticalAlignment="Center">
                                                <Run Text="(" /><Run Text="{Binding Items.Count, Mode=OneWay}" /><Run Text=")"/>
                                            </TextBlock>
                                            <Border Background="{StaticResource SoftBrush}" CornerRadius="6" Padding="5,1"
                                                    Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding OwnerAppLabel}" FontSize="10"
                                                           Foreground="{StaticResource MutedBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- 分类下的员工卡片：点击后引导到右侧对应启动器 -->
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                            CornerRadius="12" Padding="12,11" Margin="0,0,0,10"
                                                            Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding DataContext.SelectCloudSkillCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- 首字母头像块 -->
                                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                                                    Background="{StaticResource SoftBrush}" Margin="0,0,12,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name, Converter={x:Static local:FirstLetterConverter.Instance}}"
                                                                           Foreground="{StaticResource FgBrush}" FontSize="15" FontWeight="Bold"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource FgBrush}" TextWrapping="Wrap"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                                                        <Run Text="ID "/><Run Text="{Binding Id, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                    <Border Width="3" Height="3" CornerRadius="1.5" Background="{StaticResource LineBrush}"
                                                                            Margin="8,0,8,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding VisibilityLabel, Mode=OneWay}" FontSize="11"
                                                                               Foreground="{StaticResource MutedBrush}"/>
                                                                    <Border Width="3" Height="3" CornerRadius="1.5" Background="{StaticResource LineBrush}"
                                                                            Margin="8,0,8,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding DownloadLabel, Mode=OneWay}" FontSize="11"
                                                                               Foreground="{StaticResource MutedBrush}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 空态提示：直接跟随分组数量，避免依赖异步设置的布尔标记 -->
                        <TextBlock Text="暂无已创建的云端员工" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="4,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SkillGroups.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== 右侧内容区 ===== -->
        <Grid Grid.Column="1" Margin="32,28,32,24">

            <!-- ===== 程序列表页 ===== -->
            <Grid Visibility="{Binding IsProgramsActive, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="我的员工" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
                    <TextBlock Text="你的数字员工已就位，选择一位即可开始协作" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>

                    <!-- 点击左侧云端员工后的引导提示 -->
                    <Border Visibility="{Binding SkillHintText, Converter={StaticResource StringToVis}}"
                            Background="{StaticResource SoftBrush}" CornerRadius="10" Padding="14,10" Margin="0,12,0,0">
                        <TextBlock Text="{Binding SkillHintText}" FontSize="12" Foreground="{StaticResource FgBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <ScrollViewer x:Name="AppsScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Apps}" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctl:AdaptiveCardPanel MinCardWidth="320" MaxCardWidth="440" Gap="24" HorizontalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="16" Margin="0" ClipToBounds="True" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.06" Color="#000000"/>
                                </Border.Effect>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 封面图 -->
                                    <Border Grid.Row="0" ClipToBounds="True" Background="{StaticResource SoftBrush}"
                                            Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource AspectRatio}}">
                                        <Grid>
                                            <Image Source="{Binding CoverImage}" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasCover}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock x:Name="coverLetter"
                                                       Text="{Binding Name, Converter={x:Static local:FirstLetterConverter.Instance}}"
                                                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasCover}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <!-- 名称 + 描述 -->
                                    <StackPanel Grid.Row="1" Margin="16,14,16,0">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,6,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- 标签胶囊 -->
                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Tags}" Margin="16,10,16,8">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource SoftBrush}" CornerRadius="8" Padding="8,4" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 底部：状态 + 启动按钮 -->
                                    <Grid Grid.Row="3" Margin="16,10,16,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource DotIdleBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="{Binding ActionText}" Width="84" FontSize="12"
                                                Command="{Binding LaunchCommand}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource PrimaryButton}" TargetType="Button">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Grid.Column="1" Content="{Binding ActionText}" Width="84" FontSize="12"
                                                Command="{Binding DownloadCommand}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource GhostButton}" TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReady}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Grid.Column="1" Content="下线" Width="84" FontSize="12"
                                                Foreground="{StaticResource DestructiveBrush}"
                                                Command="{Binding StopCommand}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource GhostButton}" TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ===== 技能广场占位页 ===== -->
            <Grid Visibility="{Binding IsMarketplaceActive, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" TextBlock.TextAlignment="Center">
                    <TextBlock Text="技能广场" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
                    <TextBlock Text="即将开放" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ===== 设置页 ===== -->
            <Grid Visibility="{Binding IsSettingsActive, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
                    <TextBlock Text="账号信息、外观与关于" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- 账号信息卡片 -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="16" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="账号信息" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="用户名" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentUsername}" FontSize="13" Foreground="{StaticResource FgBrush}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="角色" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentRole}" FontSize="13" Foreground="{StaticResource FgBrush}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="邮箱" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Email}" FontSize="13" Foreground="{StaticResource FgBrush}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="用户 ID" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding UserId}" FontSize="13" Foreground="{StaticResource FgBrush}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="推荐码" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ReferralCode}" FontSize="13" Foreground="{StaticResource FgBrush}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="API Key" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ApiKeyDisplay}" FontSize="13" Foreground="{StaticResource FgBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 钱包余额卡片 -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="16" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="钱包余额" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
                                        <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource FgBrush}" Margin="0,10,0,0">
                                            <Run Text="¥ "/><Run Text="{Binding Balance}"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <TextBlock Text="累计充值" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Text="{Binding TotalRecharge}" FontSize="11" Foreground="{StaticResource FgBrush}" Margin="6,0,0,0"/>
                                            <TextBlock Text="累计提现" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="18,0,0,0"/>
                                            <TextBlock Text="{Binding TotalWithdraw}" FontSize="11" Foreground="{StaticResource FgBrush}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="充值"
                                            VerticalAlignment="Center" Padding="22,10"
                                            Command="{Binding OpenRechargeCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 关于卡片 -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="16" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="关于" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="产品" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="xHR 数字员工工作台" FontSize="13" Foreground="{StaticResource FgBrush}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="版本" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Version}" FontSize="13" Foreground="{StaticResource FgBrush}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="服务地址" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ApiBaseUrl}" FontSize="13" Foreground="{StaticResource FgBrush}"/>
                                </Grid>

                                <!-- 自动更新区块 -->
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock Text="{Binding UpdateStatusText}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,8"
                                               Visibility="{Binding UpdateStatusText, Converter={StaticResource StringToVis}}"/>
                                    <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding UpdateProgress}"
                                                  Visibility="{Binding IsUpdateBusy, Converter={StaticResource BoolToVis}}"
                                                  Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Style="{StaticResource GhostButton}" Content="检查更新" Padding="16,8" Margin="0,0,8,0"
                                                Command="{Binding CheckForUpdateCommand}" IsEnabled="{Binding IsUpdateBusy, Converter={StaticResource InverseBool}}"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="立即更新" Padding="16,8"
                                                Command="{Binding InstallUpdateCommand}"
                                                IsEnabled="{Binding HasUpdateAvailable}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 退出登录 -->
                        <Button Style="{StaticResource GhostButton}" Content="退出登录" Foreground="{StaticResource DestructiveBrush}"
                                HorizontalAlignment="Left" Padding="18,9" Click="Logout_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ===== 充值弹窗遮罩：根网格最后一层，整窗铺满并置顶 ===== -->
        <Grid Grid.ColumnSpan="2" Visibility="{Binding IsRechargeOpen, Converter={StaticResource BoolToVis}}"
              Background="#80000000" ZIndex="100">
            <Border Background="{StaticResource CardBrush}" CornerRadius="18" Padding="24" Width="380"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.16" Color="#000000"/>
                </Border.Effect>
                <StackPanel>

                    <!-- 标题栏 -->
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="账户充值" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
                        <Button Content="✕" Width="28" Height="28" Cursor="Hand"
                                Foreground="{StaticResource MutedBrush}" Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Right" Command="{Binding CloseRechargeCommand}"/>
                    </Grid>

                    <!-- 当前余额 -->
                    <Border Background="{StaticResource SoftBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="当前余额" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource FgBrush}" Margin="12,0,0,0" VerticalAlignment="Center">
                                <Run Text="¥ "/><Run Text="{Binding Balance}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 快捷面额 -->
                    <TextBlock Text="选择金额（元）" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding QuickAmounts}" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Margin="0,0,10,10" Padding="16,8" MinWidth="64"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding DataContext.PickQuickAmountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 自定义金额 -->
                    <TextBox x:Name="RechargeAmountBox" Style="{StaticResource InputBox}"
                             Text="{Binding RechargeAmount, UpdateSourceTrigger=PropertyChanged}"
                             Tag="输入充值金额"/>
                    <TextBlock Text="元" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,-10,0,12"/>

                    <!-- 支付方式：以后端实际开通的渠道为准，动态渲染 -->
                    <StackPanel Visibility="{Binding HasMultiplePaymentMethods, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                        <TextBlock Text="支付方式" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding PaymentMethods}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="PayMethod" Margin="0,0,20,0"
                                                 Foreground="{StaticResource FgBrush}" VerticalAlignment="Center"
                                                 Content="{Binding Label}" Tag="{Binding Key}"
                                                 Checked="PayMethod_Checked"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 二维码 / 支付链接 -->
                    <StackPanel Visibility="{Binding HasPaymentUrl, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                        <Border Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="16" HorizontalAlignment="Center">
                            <Image Source="{Binding QrImage}" Width="180" Height="180"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="扫码完成支付，或" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,10,0,4"/>
                        <Button Style="{StaticResource GhostButton}" Content="在浏览器中打开支付链接"
                                HorizontalAlignment="Center" Command="{Binding OpenPaymentLinkCommand}"/>
                    </StackPanel>

                    <!-- 状态提示 -->
                    <TextBlock Text="{Binding RechargeStatusText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                               Foreground="{StaticResource MutedBrush}"
                               Visibility="{Binding RechargeStatusText, Converter={StaticResource StringToVis}}"/>

                    <!-- 提交 -->
                    <Button Style="{StaticResource PrimaryButton}" Content="确认充值" Padding="14,10"
                            IsEnabled="{Binding IsRechargeBusy, Converter={StaticResource InverseBool}}"
                            Command="{Binding SubmitRechargeCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 启动确认弹窗遮罩：与充值弹窗同风格，整窗铺满置顶 ===== -->
        <Grid Grid.ColumnSpan="2" Visibility="{Binding IsLaunchConfirmOpen, Converter={StaticResource BoolToVis}}"
              Background="#80000000" ZIndex="100">
            <Border Background="{StaticResource CardBrush}" CornerRadius="18" Padding="24" Width="380"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.16" Color="#000000"/>
                </Border.Effect>
                <StackPanel>

                    <!-- 标题栏 -->
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="启动员工" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
                        <Button Content="✕" Width="28" Height="28" Cursor="Hand"
                                Foreground="{StaticResource MutedBrush}" Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Right" Command="{Binding CloseLaunchConfirmCommand}"/>
                    </Grid>

                    <!-- 说明文案 -->
                    <TextBlock FontSize="13" Foreground="{StaticResource FgBrush}" TextWrapping="Wrap" Margin="0,0,0,6">
                        <Run Text="「"/><Run Text="{Binding ConfirmSkillName}"/><Run Text="」需要通过"/>
                        <Run Text="「"/><Run Text="{Binding ConfirmTargetName}"/><Run Text="」使用。"/>
                    </TextBlock>
                    <TextBlock Text="是否立即启动该员工？" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,20"/>

                    <!-- 操作按钮 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource GhostButton}" Content="取消" Margin="0,0,10,0"
                                Command="{Binding CloseLaunchConfirmCommand}"/>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="确认启动" Margin="10,0,0,0"
                                Command="{Binding ConfirmLaunchCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 推荐更新弹窗：检测到新版本即弹出，可稍后再说，不强制拦截 ===== -->
        <Grid Grid.ColumnSpan="2" Visibility="{Binding IsUpdatePromptOpen, Converter={StaticResource BoolToVis}}"
              Background="#80000000" ZIndex="110">
            <Border Background="{StaticResource CardBrush}" CornerRadius="18" Padding="24" Width="380"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.16" Color="#000000"/>
                </Border.Effect>
                <StackPanel>

                    <!-- 标题栏 -->
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="发现新版本" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
                        <Button Content="✕" Width="28" Height="28" Cursor="Hand"
                                Foreground="{StaticResource MutedBrush}" Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Right" Command="{Binding DismissUpdatePromptCommand}"/>
                    </Grid>

                    <!-- 版本与说明 -->
                    <TextBlock FontSize="13" Foreground="{StaticResource FgBrush}" TextWrapping="Wrap" Margin="0,0,0,6">
                        <Run Text="新版本"/><Run Text="{Binding UpdateTargetVersion}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding UpdateStatusText}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <!-- 操作按钮 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource GhostButton}" Content="稍后再说" Margin="0,0,10,0"
                                Command="{Binding DismissUpdatePromptCommand}"/>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="立即更新" Margin="10,0,0,0"
                                Command="{Binding InstallUpdateFromPromptCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 新手引导覆盖层：首启展示，遮罩挖孔高亮 + 步骤卡片 ===== -->
        <Grid x:Name="GuideOverlay" Grid.ColumnSpan="2" Background="Transparent" Visibility="Collapsed">
            <Path Fill="#CC000000" IsHitTestVisible="False">
                <Path.Data>
                    <CombinedGeometry GeometryCombineMode="Exclude">
                        <CombinedGeometry.Geometry1>
                            <RectangleGeometry x:Name="GuideFullGeo"/>
                        </CombinedGeometry.Geometry1>
                        <CombinedGeometry.Geometry2>
                            <RectangleGeometry x:Name="GuideHoleGeo"/>
                        </CombinedGeometry.Geometry2>
                    </CombinedGeometry>
                </Path.Data>
            </Path>
            <Border x:Name="GuideHalo" BorderBrush="#FFFFFF" BorderThickness="2" CornerRadius="10"
                    Visibility="Collapsed" IsHitTestVisible="False"/>

            <Border x:Name="GuideCard" Width="320" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14"
                    Padding="20,18" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="新手引导" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
                        <TextBlock x:Name="GuideStepNo" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   Margin="10,2,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="GuideTitle" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource FgBrush}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="GuideText" FontSize="12" TextWrapping="Wrap" LineHeight="19"
                               Foreground="{StaticResource MutedBrush}"/>
                    <Grid Margin="0,18,0,0">
                        <Button x:Name="GuideSkipBtn" Style="{StaticResource GhostButton}" Content="跳过"
                                Padding="14,7" HorizontalAlignment="Left" Click="GuideSkip_Click"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="GuidePrevBtn" Style="{StaticResource GhostButton}" Content="上一步"
                                    Padding="14,7" Margin="0,0,10,0" Click="GuidePrev_Click"/>
                            <Button x:Name="GuideNextBtn" Style="{StaticResource PrimaryButton}" Content="下一步"
                                    Padding="16,7" Click="GuideNext_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
